node_modules/
*.log

# Scratch: bodies re-extracted by build scripts, one-off probes.
.body/
.probe-*.mjs

# Captured PNGs are large and regenerable, and a verification run leaves a dozen
# shot directories behind. Only the baseline's fingerprint is kept: the record
# that a regenerated baseline matches the one signed off on.
shots/*
!shots/baseline/
shots/baseline/*
!shots/baseline/fingerprint.json
